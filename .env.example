# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# Only .env.example (with placeholders / no secrets) belongs in version control.

# --- App ---
ENVIRONMENT=development

# --- CORS (comma-separated is parsed by pydantic-settings as a JSON list) ---
# CORS_ORIGINS=["http://localhost:5173"]

# --- Provider API keys ---
# The app starts even if some are missing; requests for an unconfigured
# provider return 503. Get a Gemini key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Get a Groq key at https://console.groq.com/keys
GROQ_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# --- Optional: override provider model names ---
# GEMINI_MODEL=gemini-3.6-flash
# GROQ_MODEL=openai/gpt-oss-20b

# --- Gateway (client) API keys — SEED INPUT ONLY (Step 10) ---
# Comma-separated keys (Authorization: Bearer gw_...). As of Step 10 these are
# NOT the runtime auth store — they are input to the seed command
# (`python -m app.db.seed`), which stores only their SHA-256 hash in PostgreSQL.
# Generate a dev key, e.g.:
#   python -c "import secrets; print('gw_dev_'+secrets.token_hex(16))"
GATEWAY_API_KEYS=

# --- Optional: upstream provider timeout (seconds), must be > 0 ---
# One common timeout for all LLM provider HTTP calls. Default is 30.
# LLM_TIMEOUT_SECONDS=30

# --- Database (Step 10) ---
# SQLAlchemy URL for PostgreSQL (psycopg v3 driver). Placeholder only — put real
# credentials in .env, never here. Local Homebrew Postgres example:
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/gateway

# --- Docker (Step 16) ---
# When running via `docker compose up`, DATABASE_URL is injected by Compose to
# point at the `postgres` SERVICE (not localhost) and overrides the value above:
#   postgresql+psycopg://gateway:gateway@postgres:5432/gateway
# Optional overrides for the Compose Postgres (local-dev creds, NOT real secrets):
# POSTGRES_USER=gateway
# POSTGRES_PASSWORD=gateway
# POSTGRES_DB=gateway
